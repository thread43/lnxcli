alias ginit="rm -rf .git && git init && git add . && git commit -m \"init\""
alias gist="git branch 2>/dev/null && git status -s 2>/dev/null"
alias gs="gist"
alias gici="gist && git add --all . && git commit -m \"update\" && gist"
alias gc="gici"
alias gidf="git diff"
alias gd="gidf"
alias gdc="git diff --cached"
alias gdw="git diff --word-diff=color"
alias gck="git checkout"
alias gck-="git checkout -"
alias glp="git log -p"
alias glpw="git log -p --word-diff=color"

